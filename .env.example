HTTP_ADDR=:8080
DATABASE_URL=postgres://settlement:settlement@localhost:5432/settlement?sslmode=disable
KAFKA_BROKERS=localhost:9092
ADMIN_API_KEY=change-me
AUTO_MIGRATE=true
LOG_LEVEL=info
DEFAULT_FEE_BPS=200
COMMANDS_TOPIC=payments.commands
CONSUMER_GROUP=settlement-worker
TOPIC_PARTITIONS=3
MAX_ATTEMPTS=5
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=1m
OUTBOX_POLL_INTERVAL=200ms
DLQ_CONSUMER_GROUP=settlement-dlq-store
